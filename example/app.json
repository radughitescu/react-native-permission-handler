{
  "expo": {
    "name": "permission-handler-example",
    "slug": "permission-handler-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.permissionhandler",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to demonstrate the permission flow.",
        "NSMicrophoneUsageDescription": "This app needs microphone access to demonstrate the permission flow.",
        "NSLocationWhenInUseUsageDescription": "This app needs location access to demonstrate the permission flow.",
        "NSContactsUsageDescription": "This app needs contacts access to demonstrate the permission flow."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_CONTACTS"
      ],
      "package": "com.example.permissionhandler"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "Camera",
            "Microphone",
            "LocationWhenInUse",
            "Notifications",
            "Contacts"
          ]
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
